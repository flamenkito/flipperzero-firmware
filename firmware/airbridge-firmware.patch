diff --git a/targets/f7/ble_glue/services/airbridge_serial_uuid.h b/targets/f7/ble_glue/services/airbridge_serial_uuid.h
new file mode 100644
index 00000000..c4aa7ef2
--- /dev/null
+++ b/targets/f7/ble_glue/services/airbridge_serial_uuid.h
@@ -0,0 +1,26 @@
+#pragma once
+
+/*
+ * Canonical Pocket AirBridge vendor serial UUID family.
+ *
+ * The byte arrays are in STM32WB controller order (least-significant octet first).
+ * The canonical UUID strings used by Web Bluetooth are the byte-reversed form.
+ * Keep each UUID in one named macro: tools/gen_identity.py parses this header.
+ *
+ * Service:      7b871228-baf0-c5b4-5f46-9c2613d627a3
+ * TX:           87825ec0-7398-8cb7-3242-b083eaa34f27
+ * RX:           152f7eeb-e3b7-5898-ba41-7ff66121c98d
+ * Flow control: d2d968bf-cbd8-568f-d24c-5bbddb824f25
+ * Status:       bebb7113-63db-bbae-bb45-37dbbf73b6b3
+ */
+
+#define BLE_SVC_AIRBRIDGE_SERIAL_SERVICE_UUID \
+    {0xA3, 0x27, 0xD6, 0x13, 0x26, 0x9C, 0x46, 0x5F, 0xB4, 0xC5, 0xF0, 0xBA, 0x28, 0x12, 0x87, 0x7B}
+#define BLE_SVC_AIRBRIDGE_SERIAL_TX_CHAR_UUID \
+    {0x27, 0x4F, 0xA3, 0xEA, 0x83, 0xB0, 0x42, 0x32, 0xB7, 0x8C, 0x98, 0x73, 0xC0, 0x5E, 0x82, 0x87}
+#define BLE_SVC_AIRBRIDGE_SERIAL_RX_CHAR_UUID \
+    {0x8D, 0xC9, 0x21, 0x61, 0xF6, 0x7F, 0x41, 0xBA, 0x98, 0x58, 0xB7, 0xE3, 0xEB, 0x7E, 0x2F, 0x15}
+#define BLE_SVC_AIRBRIDGE_SERIAL_FLOW_CONTROL_UUID \
+    {0x25, 0x4F, 0x82, 0xDB, 0xBD, 0x5B, 0x4C, 0xD2, 0x8F, 0x56, 0xD8, 0xCB, 0xBF, 0x68, 0xD9, 0xD2}
+#define BLE_SVC_AIRBRIDGE_SERIAL_STATUS_UUID \
+    {0xB3, 0xB6, 0x73, 0xBF, 0xDB, 0x37, 0x45, 0xBB, 0xAE, 0xBB, 0xDB, 0x63, 0x13, 0x71, 0xBB, 0xBE}
