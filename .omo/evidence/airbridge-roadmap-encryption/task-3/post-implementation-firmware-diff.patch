+static void app_bridge_adv_watchdog(AirbridgeApp* app) {
+    if(!app->ble_profile_installed || app->ble_connected) return;
+
+    uint32_t now = furi_get_tick();
+    if(now - app->ble_bridge_last_watchdog_tick < BLE_BRIDGE_ADV_WATCHDOG_MS) return;
+    app->ble_bridge_last_watchdog_tick = now;
+
+    /* Bridge mode must never kick a central off the chat link. Use only the
+     * HAL's idle-gated advertising start helper: furi_hal_bt_start_advertising()
+     * checks GapStateIdle internally and is a no-op while GAP is advertising,
+     * pairing, or connected. This recovers the long-idle/relaunch case where
+     * GAP has fallen back to Idle without disturbing active BLE relay traffic. */
+    FURI_LOG_D(TAG, "BLE Bridge watchdog: restart adv if idle");
+    furi_hal_bt_start_advertising();
+}
