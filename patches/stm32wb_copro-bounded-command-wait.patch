+++ b/wpan/interface/patterns/ble_thread/shci/shci.h
@@ -168,6 +168,7 @@ extern "C" {
     SHCI_ERR_INVALID_HCI_CMD_PARAMS = 0x12,
     SHCI_ERR_INVALID_PARAMS = 0x42,    /* only used for release < v1.13.0 */
     SHCI_ERR_INVALID_PARAMS_V2 = 0x92, /* available for release >= v1.13.0 */
+    SHCI_ERR_TIMEOUT = 0xFE,
     SHCI_FUS_CMD_NOT_SUPPORTED = 0xFF,
   } SHCI_CmdStatus_t;
 
diff --git a/wpan/interface/patterns/ble_thread/tl/command_response_wait.h b/wpan/interface/patterns/ble_thread/tl/command_response_wait.h
new file mode 100644
index 0000000..1da0862
--- /dev/null
+++ b/wpan/interface/patterns/ble_thread/tl/command_response_wait.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef struct {
+    void* context;
+    bool (*is_released)(void* context);
+    uint32_t (*now)(void* context);
+    void (*wait_step)(void* context);
+} BleCommandResponseWaitOps;
+
+static inline bool
+    ble_command_response_wait_bounded(const BleCommandResponseWaitOps* ops, uint32_t timeout) {
+    const uint32_t started = ops->now(ops->context);
+    while(!ops->is_released(ops->context)) {
+        if(ops->now(ops->context) - started >= timeout) return false;
+        ops->wait_step(ops->context);
+    }
+    return true;
+}
diff --git a/wpan/interface/patterns/ble_thread/tl/hci_tl.c b/wpan/interface/patterns/ble_thread/tl/hci_tl.c
index 2786e14..fba5708 100644
--- a/wpan/interface/patterns/ble_thread/tl/hci_tl.c
+++ b/wpan/interface/patterns/ble_thread/tl/hci_tl.c
@@ -24,6 +24,7 @@
 #include "stm_list.h"
 #include "tl.h"
 #include "hci_tl.h"
+#include "command_response_wait.h"
 
 /* Private typedef -----------------------------------------------------------*/
 typedef enum
@@ -60,6 +61,9 @@ static volatile HCI_TL_CmdRespStatus_t CmdRspStatusFlag;
 
 /* Private function prototypes -----------------------------------------------*/
 static void NotifyCmdStatus(HCI_TL_CmdStatus_t hcicmdstatus);
+static bool Cmd_Response_Released(void *context);
+static uint32_t Cmd_Response_Now(void *context);
+static void Cmd_Response_Wait_Step(void *context);
 static void SendCmd(uint16_t opcode, uint8_t plen, void *param);
 static void TlEvtReceived(TL_EvtPacket_t *hcievt);
 static void TlInit( TL_CmdPacket_t * p_cmdbuffer );
@@ -167,7 +171,11 @@ int hci_send_req(struct hci_request *p_cmd, uint8_t async)
 
   while(local_cmd_status == HCI_TL_CmdBusy)
   {
-    hci_cmd_resp_wait(HCI_TL_DEFAULT_TIMEOUT);
+    if (!hci_cmd_resp_wait(HCI_TL_DEFAULT_TIMEOUT))
+    {
+      NotifyCmdStatus(HCI_TL_CmdAvailable);
+      return -1;
+    }
 
     /**
      * Process Cmd Event
@@ -289,13 +297,39 @@ static void TlEvtReceived(TL_EvtPacket_t *hcievt)
 }
 
 /* Weak implementation ----------------------------------------------------------------*/
-__WEAK void hci_cmd_resp_wait(uint32_t timeout)
+__WEAK bool hci_cmd_resp_wait(uint32_t timeout)
 {
-  (void)timeout;
+  /* R0: never dereference an unregistered io hook. If GetTick was not
+   * registered, fail OPEN (return false) instead of hanging or faulting. */
+  if (hciContext.io.GetTick == 0)
+  {
+    return false;
+  }
 
-  while(CmdRspStatusFlag != HCI_TL_CMD_RESP_RELEASE);
+  const BleCommandResponseWaitOps ops = {
+    .context = NULL,
+    .is_released = Cmd_Response_Released,
+    .now = Cmd_Response_Now,
+    .wait_step = Cmd_Response_Wait_Step,
+  };
+  return ble_command_response_wait_bounded(&ops, timeout);
+}
 
-  return;
+static bool Cmd_Response_Released(void *context)
+{
+  (void)context;
+  return CmdRspStatusFlag == HCI_TL_CMD_RESP_RELEASE;
+}
+
+static uint32_t Cmd_Response_Now(void *context)
+{
+  (void)context;
+  return (uint32_t)hciContext.io.GetTick();
+}
+
+static void Cmd_Response_Wait_Step(void *context)
+{
+  (void)context;
 }
 
 __WEAK void hci_cmd_resp_release(uint32_t flag)
