   /**
    * The command complete of a system command does not have the header
@@ -165,7 +173,7 @@ void shci_send( uint16_t cmd_code, uint8_t len_cmd_payload, uint8_t * p_cmd_payl
 
   Cmd_SetStatus(SHCI_TL_CmdAvailable);
 
-  return;
