-void shci_send( uint16_t cmd_code, uint8_t len_cmd_payload, uint8_t * p_cmd_payload, TL_EvtPacket_t * p_rsp )
+bool shci_send( uint16_t cmd_code, uint8_t len_cmd_payload, uint8_t * p_cmd_payload, TL_EvtPacket_t * p_rsp )
 {
   Cmd_SetStatus(SHCI_TL_CmdBusy);
 
@@ -155,7 +159,11 @@ void shci_send( uint16_t cmd_code, uint8_t len_cmd_payload, uint8_t * p_cmd_payl
   CmdRspStatusFlag = SHCI_TL_CMD_RESP_WAIT;
   shciContext.io.Send(0,0);
 
-  shci_cmd_resp_wait(SHCI_TL_DEFAULT_TIMEOUT);
+  if (!shci_cmd_resp_wait(SHCI_TL_DEFAULT_TIMEOUT))
+  {
+    Cmd_SetStatus(SHCI_TL_CmdAvailable);
