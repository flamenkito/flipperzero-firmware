 }
 
 /* Private functions ---------------------------------------------------------*/
@@ -233,13 +241,39 @@ static void TlUserEvtReceived(TL_EvtPacket_t *shcievt)
 }
 
 /* Weak implementation ----------------------------------------------------------------*/
-__WEAK void shci_cmd_resp_wait(uint32_t timeout)
+__WEAK bool shci_cmd_resp_wait(uint32_t timeout)
 {
-  (void)timeout;
+  /* R0: never dereference an unregistered io hook. If GetTick was not
+   * registered, fail OPEN (return false) instead of hanging or faulting. */
+  if (shciContext.io.GetTick == 0)
+  {
+    return false;
+  }
 
-  while(CmdRspStatusFlag != SHCI_TL_CMD_RESP_RELEASE);
+  const BleCommandResponseWaitOps ops = {
+    .context = NULL,
+    .is_released = Cmd_Response_Released,
+    .now = Cmd_Response_Now,
+    .wait_step = Cmd_Response_Wait_Step,
+  };
+  return ble_command_response_wait_bounded(&ops, timeout);
+}
 
-  return;
+static bool Cmd_Response_Released(void *context)
+{
+  (void)context;
+  return CmdRspStatusFlag == SHCI_TL_CMD_RESP_RELEASE;
+}
+
+static uint32_t Cmd_Response_Now(void *context)
+{
+  (void)context;
+  return (uint32_t)shciContext.io.GetTick();
+}
+
+static void Cmd_Response_Wait_Step(void *context)
+{
+  (void)context;
 }
 
