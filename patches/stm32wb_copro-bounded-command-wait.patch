From 94971272a46fa4dbed39bf5cdee9ba1d3914b9a2 Mon Sep 17 00:00:00 2001
From: flamenkito <flamenkito@users.noreply.github.com>
Date: Mon, 7 Sep 2026 16:16:25 +0200
Subject: [PATCH] ble_thread: bound SHCI/HCI command-response waits, propagate
 timeout status

shci_send/hci_send return bool (false on bounded wait timeout) instead of
waiting forever; SHCI call sites return SHCI_ERR_TIMEOUT rather than
consuming an unanswered response buffer. Local-only commit for Pocket
AirBridge production hardening; patch exported at patches/stm32wb_copro-bounded-command-wait.patch
---
 .../interface/patterns/ble_thread/shci/shci.c | 47 ++++++++++-------
 .../interface/patterns/ble_thread/shci/shci.h |  1 +
 .../ble_thread/tl/command_response_wait.h     | 21 ++++++++
 .../interface/patterns/ble_thread/tl/hci_tl.c | 44 ++++++++++++++--
 .../interface/patterns/ble_thread/tl/hci_tl.h |  7 +--
 .../patterns/ble_thread/tl/shci_tl.c          | 50 +++++++++++++++----
 .../patterns/ble_thread/tl/shci_tl.h          |  9 ++--
 7 files changed, 140 insertions(+), 39 deletions(-)
 create mode 100644 wpan/interface/patterns/ble_thread/tl/command_response_wait.h

diff --git a/wpan/interface/patterns/ble_thread/shci/shci.c b/wpan/interface/patterns/ble_thread/shci/shci.c
index 727a9e6..b6a8850 100644
--- a/wpan/interface/patterns/ble_thread/shci/shci.c
+++ b/wpan/interface/patterns/ble_thread/shci/shci.c
@@ -290,11 +290,14 @@ SHCI_CmdStatus_t SHCI_C2_BLE_Init( SHCI_C2_Ble_Init_Cmd_Packet_t *pCmdPacket )
 
   p_rsp = (TL_EvtPacket_t *)local_buffer;
 
- shci_send( SHCI_OPCODE_C2_BLE_INIT,
-            sizeof( SHCI_C2_Ble_Init_Cmd_Param_t ),
-            (uint8_t*)&pCmdPacket->Param,
-            p_rsp );
- 
+  if (!shci_send( SHCI_OPCODE_C2_BLE_INIT,
+                  sizeof( SHCI_C2_Ble_Init_Cmd_Param_t ),
+                  (uint8_t*)&pCmdPacket->Param,
+                  p_rsp ))
