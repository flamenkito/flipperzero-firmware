+  }
 
   return (SHCI_CmdStatus_t)(((TL_CcEvt_t*)(p_rsp->evtserial.evt.payload))->payload[0]);
 }
@@ -618,10 +627,13 @@ SHCI_CmdStatus_t SHCI_C2_Config(SHCI_C2_CONFIG_Cmd_Param_t *pCmdPacket)
 
   p_rsp = (TL_EvtPacket_t *)local_buffer;
 
-  shci_send( SHCI_OPCODE_C2_CONFIG,
-             sizeof(SHCI_C2_CONFIG_Cmd_Param_t),
-             (uint8_t*)pCmdPacket,
-             p_rsp );
+  if (!shci_send( SHCI_OPCODE_C2_CONFIG,
+                  sizeof(SHCI_C2_CONFIG_Cmd_Param_t),
+                  (uint8_t*)pCmdPacket,
+                  p_rsp ))
+  {
+    return SHCI_ERR_TIMEOUT;
+  }
 
   return (SHCI_CmdStatus_t)(((TL_CcEvt_t*)(p_rsp->evtserial.evt.payload))->payload[0]);
 }
@@ -759,4 +771,3 @@ SHCI_CmdStatus_t SHCI_GetWirelessFwInfo( WirelessFwInfo_t* pWirelessInfo )
 
