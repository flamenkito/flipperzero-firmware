   return (SHCI_CmdStatus_t)(((TL_CcEvt_t*)(p_rsp->evtserial.evt.payload))->payload[0]);
 }
 
@@ -555,10 +558,13 @@ SHCI_CmdStatus_t SHCI_C2_Reinit( void )
 
   p_rsp = (TL_EvtPacket_t *)local_buffer;
 
-  shci_send( SHCI_OPCODE_C2_REINIT,
-             0,
-             0,
-             p_rsp );
+  if (!shci_send( SHCI_OPCODE_C2_REINIT,
+                  0,
+                  0,
+                  p_rsp ))
+  {
+    return SHCI_ERR_TIMEOUT;
+  }
 
   return (SHCI_CmdStatus_t)(((TL_CcEvt_t*)(p_rsp->evtserial.evt.payload))->payload[0]);
 }
@@ -600,10 +606,13 @@ SHCI_CmdStatus_t SHCI_C2_SetFlashActivityControl(SHCI_C2_SET_FLASH_ACTIVITY_CONT
 
   local_buffer[0] = (uint8_t)Source;
 
-  shci_send( SHCI_OPCODE_C2_SET_FLASH_ACTIVITY_CONTROL,
